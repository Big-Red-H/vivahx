# Plain HTTP stays plain HTTP: classic Mac OS browsers can't use modern HTTPS.
DirectoryIndex index.html
AddDefaultCharset utf-8
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Links to the old PHP front page.
    RewriteRule ^index\.php$ / [R=301,L]
</IfModule>
